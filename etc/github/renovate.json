{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jenkinsci/renovate-config"
  ],
  "commitMessageAction": "Bump",
  "ignorePaths": [
    "src/**"
  ],
  "packageRules": [
    {
      "allowedVersions": "!/-jdk5$/",
      "matchPackageNames": [
        "net.bytebuddy:byte-buddy"
      ],
      "description": "Exclude the -jdk5 classifier, we want the regular package"
    }
  ]
}
